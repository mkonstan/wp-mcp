{
    "name": "mkonstan/wp-mcp",
    "description": "Self-hosted MCP server for WordPress. Dev-only composer manifest: the plugin ships as plain PHP with no runtime dependencies.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "Max Konstantinovski",
            "homepage": "https://github.com/mkonstan"
        }
    ],
    "require-dev": {
        "phpunit/phpunit": "^10",
        "guzzlehttp/guzzle": "^7"
    },
    "autoload-dev": {
        "psr-4": {
            "WpMcp\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test:unit": "phpunit --testsuite unit",
        "test:integration": "phpunit --testsuite integration"
    },
    "scripts-descriptions": {
        "test": "Run every suite (integration self-skips when WPMCP_TEST_URL is unset).",
        "test:unit": "Pure PHP, no WordPress, no Docker.",
        "test:integration": "Black-box HTTP against WPMCP_TEST_URL."
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {}
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
